{
	"manifest_version": 3,
	"name": "Obsidian Web Clipper for LiveSync",
	"homepage_url": "https://github.com/uoFishbox/obsidian-clipper-for-livesync",
	"version": "1.8.4.2",
	"version_name": "1.8.4-livesync.2",
	"description": "Clip web pages as Markdown and save to Obsidian or directly to Self-hosted LiveSync.",
	"permissions": [
		"activeTab",
		"clipboardWrite",
		"contextMenus",
		"nativeMessaging",
		"storage",
		"scripting"
	],
	"host_permissions": [
		"<all_urls>",
		"http://*/*",
		"https://*/*"
	],
	"optional_host_permissions": ["http://*/*", "https://*/*"],
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"options_ui": {
		"page": "settings.html"
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["http://*/*", "https://*/*"],
			"js": ["content-loader.js"]
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["reader.css", "reader-script.js", "browser-polyfill.min.js", "style.css", "side-panel.html", "flatten-shadow-dom.js", "highlighter.css"],
			"extension_ids": ["*"],
			"matches": [ "*://*/*" ]
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+Shift+O",
				"mac": "Command+Shift+O"
			},
			"description": "Open Obsidian Clipper"
		},
		"quick_clip": {
			"suggested_key": {
				"default": "Alt+Shift+O",
				"mac": "Alt+Shift+O"
			},
			"description": "Quick clip"
		},
		"toggle_highlighter": {
			"suggested_key": {
				"default": "Alt+Shift+H",
				"mac": "Alt+Shift+H"
			},
			"description": "Toggle highlighter mode"
		},
		"toggle_reader": {
			"suggested_key": {
				"default": "Alt+Shift+R",
				"mac": "Alt+Shift+R"
			},
			"description": "Toggle reading view"
		}
	}
}
